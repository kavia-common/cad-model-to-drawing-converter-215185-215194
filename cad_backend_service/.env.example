# Backend service environment configuration

# Database connection URL (use PostgreSQL from cad_database container or default to SQLite for local dev)
# Example for Postgres:
# DATABASE_URL=postgresql+psycopg2://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
# Example for SQLite (local dev fallback):
# DATABASE_URL=sqlite:///./app.db
DATABASE_URL=

# JWT secret key for signing tokens (must be kept secret in real environments)
JWT_SECRET=change-this-in-prod

# Token expiration in minutes
JWT_EXPIRE_MIN=60

# Local storage directory for uploads, outputs, and previews
STORAGE_DIR=./storage

# CORS allowed origins (comma separated). Include frontend dev URL.
ALLOWED_ORIGINS=http://localhost:3000
